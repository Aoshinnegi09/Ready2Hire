# Ready2Hire Environment Configuration

# Client-side Supabase credentials (safe for browser bundle)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Server-side service key (STRICTLY for scripts/seed.mjs and Edge Functions; NEVER import in src/frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# Optional LLM API Key (used in Supabase Edge Functions for advanced semantic resume suggestions; optional rule-based fallback active by default)
OPTIONAL_LLM_API_KEY=

# Local development / Demo flags
VITE_APP_ENV=development
VITE_ENABLE_GOOGLE_OAUTH=false
VITE_DEMO_MODE=true
